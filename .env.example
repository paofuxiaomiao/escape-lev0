# App
NODE_ENV=production
PORT=3000
VITE_APP_ID=
VITE_ENDING_VIDEO_URL=/manus-storage/ending/LEV0_backrooms_bilingual_61410_source_subs_bright.mp4
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Database: Aliyun RDS MySQL or any MySQL-compatible database.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Video storage: Aliyun OSS. When these are set, uploads use OSS first.
OSS_REGION=oss-cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_PUBLIC_BASE_URL=

# Optional fallback storage for Manus/Forge environments.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
